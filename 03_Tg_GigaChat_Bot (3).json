    {
      "parameters": {
        "jsCode": "const tgData = $('Telegram Trigger').first().json;\n\nreturn [{\n  json: {\n    chat_id: tgData.message?.chat?.id || tgData.chat?.id || tgData.chat_id,\n    username: tgData.message?.from?.username || tgData.from?.username || '',\n    user_message: tgData.message?.text || tgData.text || ''\n  }\n}];"
      },
      "id": "58110e62-5494-4558-ae8d-e191e9cb2e6c",
      "name": "Code in JavaScript ParseTelegramMessage",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        368
      ]
    },
    {
      "parameters": {
        "jsCode": "// 1. Получаем данные из SQL-нод и Telegram\nconst tgData = $('Telegram Trigger').first().json;\nconst clientData = $('Execute a SQL query Клиент').first()?.json || {};\nconst productData = $('Execute a SQL query Product search').first()?.json || {};\nconst deliveryData = $('SQL_Delivery1').first()?.json || {};\n\n// 2. Базовые переменные\nconst userText = tgData.text || tgData.user_message || 'Приветствие';\nconst chatId = tgData.chat_id || tgData.message?.chat?.id;\n\n// 3. Данные клиента\nconst clientType = clientData?.client_type || 'retail';\nconst discount = clientData?.discount_percent || 0;\nconst firstName = clientData?.first_name || 'Клиент';\n\n// 4. Данные товара (Fallback логика)\nlet productContext = \"Товар не распознан. Уточни, какой товар тебя интересует.\";\nlet isProductFound = false;\n\nif (productData && productData.name) {\n  isProductFound = true;\n  const price = clientType === 'wholesale' ? productData.price_wholesale : productData.price_retail;\n  productContext = `\n- Товар: ${productData.name}\n- Цена для клиента: ${price} руб. за ${productData.unit}\n- Остаток на складе: ${productData.stock_quantity} ${productData.unit}`;\n}\n\n// 5. Данные доставки\nlet deliveryContext = \"Регион доставки не указан или не найден в базе.\";\nif (deliveryData && deliveryData.zone) {\n  deliveryContext = `\n- Зона доставки: ${deliveryData.zone}\n- Стоимость доставки: ${deliveryData.base_cost} руб.\n- Сроки: ${deliveryData.delivery_days}\n- Правила: ${deliveryData.rule_text}`;\n}\n\n// 6. Системный промпт\nconst systemPrompt = `Ты — ИИ-ассистент отдела продаж компании стройматериалов.\nЖЁСТКИЕ ПРАВИЛА (152-ФЗ и PEf03):\n1. ТЫ НЕ СЧИТАЕШЬ МАТЕМАТИКУ. Используй ТОЛЬКО предоставленные ниже цифры.\n2. НИКОГДА не выдумывай цены, наличие или условия доставки.\n3. НИКОГДА не повторяй ИНН, паспорта, email и телефоны.\n4. 4. Если клиент НЕ авторизован (тип: retail), а просит оптовые цены, ответь: \"Оптовые цены доступны только авторизованным дистрибьюторам. Укажите ваш ИНН или email для проверки.\"\n\nДАННЫЕ ИЗ БД (Используй ТОЛЬКО их):\n- Клиент: ${firstName} (Тип: ${clientType}, Скидка: ${discount}%)\n${productContext}\n${deliveryContext}\n\nВОПРОС КЛИЕНТА: \"${userText}\"\n\nТВОЯ ЗАДАЧА:\n${isProductFound \n  ? 'Сформируй краткий, вежливый и деловой ответ (2-4 предложения). Назови точную цену, остаток, стоимость и сроки доставки, если они есть в данных выше. В конце предложи оформить заказ.' \n  : 'Товар не найден в базе или запрос неясен. Вежливо извинись, скажи, что не смог найти такой товар в текущем каталоге, и попроси клиента уточнить название или задать другой вопрос по стройматериалам.'}`;\n\n// 7. Маскирование ПДн для логирования (152-ФЗ)\nconst chatIdStr = String(chatId);\nconst maskedChatId = chatIdStr.length > 6 \n  ? chatIdStr.substring(0, 3) + '****' + chatIdStr.substring(chatIdStr.length - 3) \n  : '***';\n\n// 8. Возврат данных (БЕЗ access_token — он будет получен позже)\nreturn {\n  json: {\n    chat_id: chatId,\n    client_type: clientType,\n    system_prompt: systemPrompt,\n    user_message: userText,\n    log_chat_id: maskedChatId,\n    log_user_message: userText.length > 50 ? userText.substring(0, 50) + '...' : userText,\n    log_client_type: clientType\n  }\n};"
      },

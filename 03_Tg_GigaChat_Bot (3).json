    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH user_words AS (\n  SELECT regexp_replace(word, '[^а-яёa-z0-9]', '', 'g') AS clean_word\n  FROM unnest(string_to_array(lower('{{ $('Code in JavaScript ParseTelegramMessage').first().json.user_message }}'), ' ')) AS word\n  WHERE length(regexp_replace(word, '[^а-яёa-z0-9]', '', 'g')) > 3\n),\nmatched_cities AS (\n  SELECT DISTINCT cs.city_name\n  FROM user_words uw\n  JOIN city_synonyms cs ON lower(cs.synonym) = uw.clean_word\n)\nSELECT dr.zone, dr.cities, dr.base_cost, dr.delivery_days, dr.rule_text\nFROM matched_cities mc\nJOIN delivery_rules dr ON dr.zone = mc.city_name OR dr.cities ILIKE '%' || mc.city_name || '%'\nLIMIT 1;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        448,
        368
      ],
      "id": "52be96bb-284a-4f2b-ba2f-988e39becb67",
      "name": "SQL_Delivery1",
      "credentials": {

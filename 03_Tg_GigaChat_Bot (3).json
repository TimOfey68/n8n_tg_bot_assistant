    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH search_words AS (\n  SELECT regexp_replace(word, '[^а-яёa-z0-9]', '', 'g') AS clean_word\n  FROM unnest(string_to_array(lower('{{ $json.user_message }}'), ' ')) AS word\n  WHERE length(regexp_replace(word, '[^а-яёa-z0-9]', '', 'g')) > 3\n),\nfts_matches AS (\n  SELECT name, price_retail, price_wholesale, stock_quantity, unit,\n         ts_rank(to_tsvector('russian', name), to_tsquery('russian', clean_word)) AS rank\n  FROM search_words, products\n  WHERE to_tsvector('russian', name) @@ to_tsquery('russian', clean_word)\n),\ntrigram_matches AS (\n  SELECT name, price_retail, price_wholesale, stock_quantity, unit,\n         similarity(name, clean_word) AS sim\n  FROM search_words, products\n  WHERE similarity(name, clean_word) > 0.3\n)\nSELECT name, price_retail, price_wholesale, stock_quantity, unit\nFROM fts_matches\nUNION\nSELECT name, price_retail, price_wholesale, stock_quantity, unit\nFROM trigram_matches\nORDER BY name\nLIMIT 1;",
        "options": {}
      },
      "id": "b2fceed0-4a43-4b7d-846f-352693d4f505",
